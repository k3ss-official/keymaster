# ═══════════════════════════════════════════════════════════════
#  KEYMASTER — Environment Variables
#  Copy to .env — never commit real values
# ═══════════════════════════════════════════════════════════════

# ── 1Password CLI ────────────────────────────────────────────
# Run `op signin` first — Keymaster uses the active session
OP_ACCOUNT=my.1password.com

# ── Telegram (for rotation reports) ──────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# BotFather target when rotating the bot token itself (browser rotator)
KEYMASTER_TELEGRAM_BOT_NAME=Rae_plex_bot

# ── Glass-break backup ────────────────────────────────────────
GLASS_BREAK_REPO=k3ss-official/keymaster-vault
GLASS_BREAK_GITHUB_TOKEN=
GLASS_BREAK_ENCRYPT_PASSPHRASE=

# ── Gemini / Google Cloud (API key admin) ─────────────────────
# Required only when rotating Gemini via the Cloud API Keys API.
# The vault item's CONCEALED field for gemini should hold an OAuth2
# access token with roles/serviceusage.apiKeysAdmin for rotate;
# validate() still checks the resulting Gemini API key string.
GOOGLE_CLOUD_PROJECT=

# ── Keymaster runtime ─────────────────────────────────────────
KEYMASTER_DRY_RUN=false
KEYMASTER_LOG_LEVEL=INFO
