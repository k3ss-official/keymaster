# ═══════════════════════════════════════════════════════════════
#  KEYMASTER — Environment Variables
#  Copy to .env — never commit real values
# ═══════════════════════════════════════════════════════════════

# ── 1Password CLI ────────────────────────────────────────────
# Run `op signin` first — Keymaster uses the active session
OP_ACCOUNT=my.1password.com          # your 1P account URL

# ── Telegram (for rotation reports) ──────────────────────────
TELEGRAM_BOT_TOKEN=                  # from @Rae_plex_bot
TELEGRAM_CHAT_ID=                    # your chat ID

# ── Glass-break backup ────────────────────────────────────────
GLASS_BREAK_REPO=k3ss-official/keymaster-vault
GLASS_BREAK_GITHUB_TOKEN=            # PAT with repo scope
GLASS_BREAK_ENCRYPT_PASSPHRASE=      # strong passphrase for gpg

# ── Keymaster runtime ─────────────────────────────────────────
KEYMASTER_DRY_RUN=false              # set true to audit without rotating
KEYMASTER_LOG_LEVEL=INFO
